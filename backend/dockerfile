FROM maven:3.8.3-openjdk-17 AS builder
COPY ./backend /opt/
WORKDIR /opt
RUN mvn clean package 

FROM eclipse-temurin:17-jre-alpine
WORKDIR /backend
COPY --from=builder /opt/target/student-registration-backend-0.0.1-SNAPSHOT.jar ./
EXPOSE 8080
ENTRYPOINT ["java","-jar"]
CMD ["student-registration-backend-0.0.1-SNAPSHOT.jar"]
